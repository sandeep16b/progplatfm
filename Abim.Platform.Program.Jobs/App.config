    <add key="tokenEndPoint" value="https://devidentitysts.abim.org/identity/connect/token" />
    <add key="oauth_client" value="8943522b-3d38-4a1f-8b2c-eea072301547" />
    <add key="oauth_secret" value="devserver.client" />


	<add key="ProfileHostUrl" value="https://devmembershipapi.abim.org/" /> 
	<add key="ProductHostUrl" value="https://devproduct.abim.org/" />
    <add key="ProgramHostUrl" value="https://devprogram.abim.org/" />
    <add key="RegistrationHostUrl" value="https://devregistration.abim.org/" />

    <!-- 3. RabbitMQ Settings -->
    <add key="RabbitMQ.Path" value="rabbitmq://rabbitmqdev.abim.org:5671/PlatformT4" />
    <add key="RabbitMQ.Queue.RegistrationCreated" value="program_registrationCreated_queue" />
    <add key="RabbitMQ.Queue.CorrectiveAction" value="program_correctiveAction_queue" />
    <add key="RabbitMQ.Queue.FPHMAttestInitial" value="program_fphmAttestInitial_queue" />
    <add key="RabbitMQ.Queue.ExamResultRelay" value="program_examResultRelay_queue" />
    <add key="RabbitMQ.Queue.LngParticipationResult" value="program_lngParticipationResult_queue" />
    <add key="RabbitMQ.Queue.LKAEnrollment" value="program_lka_enrollment_queue" />
    <add key="RabbitMQ.Queue.LKAUnenrollment" value="program_lka_unenrollment_queue" />
    <add key="RabbitMQ.User" value="Platform" />
    <add key="RabbitMQ.Password" value="2DlkXcHicWLW" />
    <add key="RabbitMQ.UseSSL" value="True" />
    <!-- 4. Feature Toggling -->
    <add key="FeatureToggle.Feature_Metrics" value="false" />
    <add key="FeatureToggle.Feature_MassTransit" value="true" />
    <add key="FeatureToggle.Feature_RestApi" value="true" />
    <add key="FeatureToggle.Feature_HangfireDashboard" value="true" />
    <add key="FeatureToggle.Feature_ErrorPage" value="false" />
    <add key="FeatureToggle.Feature_WelcomePage" value="true" />
    <add key="FeatureToggle.Feature_MetricsConsole" value="false" />
    <add key="FeatureToggle.Feature_MetricsEndpoint" value="false" />
    <add key="FeatureToggle.Feature_RedisCache" value="false" />
    <!-- 5. Swagger Settings -->
    <add key="EnableSwagger" value="True" />
    <!-- 6. Hangfire Settings -->
    <add key="HangfireUsername1" value="hangfireuser" />
    <add key="HangfirePassword1" value="hangfire" />
    <add key="HangfireQueueName" value="program" />
    <add key="HangfireUsers" value="1" />
    <!--Octopus will replace the username and password values below-->
    <add key="HangfireUsername1" value="hangfireuser" />
    <add key="HangfirePassword1" value="hangfire" />
    <add key="HangfireUsername2" value="hangfireuser" />
    <add key="HangfirePassword2" value="hangfire" />
    <add key="HangfireUsername3" value="hangfireuser" />
    <add key="HangfirePassword3" value="hangfire" />
    <add key="HangfireUsername4" value="hangfireuser" />
    <add key="HangfirePassword4" value="hangfire" />
    <add key="HangfireUsername5" value="hangfireuser" />
    <add key="HangfirePassword5" value="hangfire" />
    <add key="HangfireMaxRecordsToProcess" value="100" />
    <!-- 7. Other Settings -->
    <add key="AdminGroup" value="DevAdmin" />
    <add key="Metrics.RefreshInterval" value="00.05.00" />
    <add key="ClaimType.AbimId" value="http://schemas.abim.org/2016/identifier/abim" />
    <add key="ClaimType.ProfileId" value="http://schemas.abim.org/2016/identifier/profileid" />
    <add key="ClaimType.Role" value="http://schemas.microsoft.com/ws/2008/06/identity/claims/role" />
    <add key="ClaimType.ADFSBackDoor" value="DevEnvironmentAdmins" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="Redis.Host" value="localhost" />
    <add key="Redis.Port" value="32768" />
    <add key="MongoDb.Server" value="mongodb://localhost" />
    <add key="MongoDb.Database" value="Certification" />
    <add key="RunningStatusText" value="RUNNING" />
    <add key="StoppingStatusText" value="STOPPING" />
    <add key="CooldownSeconds" value="1" />
    <add key="ExactTarget:PrintLetterQueue" value="printletterQA@abim.org" />
    <add key="UsePollyForInterservice" value="true" />
    <add key="PollyRetries" value="10" />
    <add key="PollyInterservicePauseBetweenRetries" value="5" />
    <!-- 8. Background Jobs Client Credential --> 
	<add key="backgroundClientId" value="8943522b-3d38-4a1f-8b2c-eea072301547" />
	<add key="backgroundClientSecret" value="devserver.client" />
    <!--9. NCache-->
    <add key="ncache.application_id" value="programApp" />
    <add key="nhibernate-logger" value="NHibernate.Logging.CommonLogging.CommonLoggingLoggerFactory, NHibernate.Logging.CommonLogging" />
    <!-- 10. Enviroment-->
    <add key="Abim.Common.Env" value="DEV" />
  </appSettings>
