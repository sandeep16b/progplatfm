<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="HangfireDatabase" connectionString="Data Source=PPUABIMSQLT07;Initial Catalog=T7Certification;Integrated Security=True;Connect Timeout=15;Encrypt=False;TrustServerCertificate=False" providerName="System.Data.SqlClient" />

    <!--<add name="HangfireDatabase" connectionString="Data Source=localhost;Initial Catalog=Hangfire;Integrated Security=True;Connect Timeout=15;Encrypt=False;TrustServerCertificate=False" providerName="System.Data.SqlClient" />-->
    <add name="Certification" connectionString="Data Source=PPUABIMSQLT07;Initial Catalog=T7Certification;Integrated Security=True;Connect Timeout=15;Encrypt=False;TrustServerCertificate=False" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- 1. Owin Hosting -->
    <add key="OwinUrl" value="https://localhost:44311/" />
