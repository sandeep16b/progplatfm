		{
			"name": "Get Sources",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"",
							"",
							"if(!XMLHttpRequest.prototype.touched){",
							"    var realOpen = XMLHttpRequest.prototype.open;",
							"    XMLHttpRequest.prototype.open = function(method, url){",
							"        this._url = url;",
							"        return realOpen.apply(this, arguments);",
							"    };",
							"    ",
							"    var lastTokenFetched = 0;",
							"    function ticks(){",
							"        return (new Date()).getTime();",
							"    }",
							"    function getToken(){",
							"        var now = ticks();",
							"        if(now - ticks > 1000 * 60 * 30){",
							"            ",
							"        }",
							"    }",
							"    ",
							"    var realSend = XMLHttpRequest.prototype.send;",
							"    XMLHttpRequest.prototype.send = function(a, b, c){",
							"        if(this._url.indexOf('connect/token') == -1){",
							"            this.setRequestHeader('Authorization', 'Bearer ' + getToken());",
							"            this.realSend.apply(this, arguments);",
							"        }",
							"    };",
							"    XMLHttpRequest.prototype.touched = function(){};",
							"}"
						]
					}
				}
			],
