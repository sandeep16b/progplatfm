<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>ABIM</Authors>
    <Company>ABIM</Company>
    <Product>ABIM</Product>
    <Version>1.0.0</Version>
    <AssemblyName>Abim.Enterprise.Core.Program.Interservice</AssemblyName>
    <RootNamespace>Abim.Enterprise.Core.Program.Interservice</RootNamespace>
    <Description>Program Interservice</Description>
    <NuspecFile>Abim.Enterprise.Core.Program.Interservice.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version); id=$(AssemblyName); title=$(AssemblyName); author=$(Authors); owners=$(Authors); description=$(Description)</NuspecProperties>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="WebApiContrib.Core.Formatter.Protobuf">
         <Version>2.0.1</Version>
    </PackageReference> 
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="WebApiContrib.Formatting.Protobuf">
        <Version>0.9.5.0</Version>
    </PackageReference> 
    <PackageReference Include="protobuf-net">
        <Version>2.0.0.480</Version>
    </PackageReference> 
  </ItemGroup>  

  <ItemGroup>
    <Compile Remove="Shared\ProgramRulesExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.18.0" />
	<PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" />
	<PackageReference Include="IdentityModel" Version="3.0.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Polly" Version="5.8.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abim.Enterprise.Core.Program.Resources\Abim.Enterprise.Core.Program.Resources.csproj" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="REM if exist &quot;C:\Git\Abim.Platform.Program\Abim.Enterprise.Core.Program.Interservice\obj\Debug&quot; rd /s /q &quot;C:\Git\Abim.Platform.Program\Abim.Enterprise.Core.Program.Interservice\obj\Debug&quot;" />
  </Target>

</Project>