<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net452</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>ABIM</Authors>
    <Company>ABIM</Company>
    <Product>ABIM</Product>
    <Version>1.0.0</Version>
    <AssemblyName>Abim.Enterprise.Core.Program.Resources</AssemblyName>
    <RootNamespace>Abim.Enterprise.Core.Program.Resources</RootNamespace>
    <Description>Program Resources</Description>
    <NuspecFile>Abim.Enterprise.Core.Program.Resources.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version); id=$(AssemblyName); title=$(AssemblyName); author=$(Authors); owners=$(Authors); description=$(Description)</NuspecProperties>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="WebApiContrib.Core.Formatter.Protobuf">
      <Version>2.0.1</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNet.WebApi.Client">
      <Version>5.2.7</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <PackageReference Include="WebApiContrib.Formatting.Protobuf">
      <Version>0.9.5.0</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNet.WebApi.Client">
      <Version>5.2.3</Version>
    </PackageReference>
    <PackageReference Include="protobuf-net">
      <Version>2.0.0.480</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.7.2" />
    <PackageReference Include="Microsoft.CSharp" Version="4.5.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abim.Platform.Program.Core\Abim.Platform.Program.Core.csproj" />
  </ItemGroup>

</Project>