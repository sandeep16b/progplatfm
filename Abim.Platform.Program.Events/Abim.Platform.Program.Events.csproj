<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>ABIM</Authors>
    <Company>ABIM</Company>
    <Program>ABIM</Program>
    <Version>1.0.0</Version>
    <AssemblyName>Abim.Platform.Program.Events</AssemblyName>
    <RootNamespace>Abim.Platform.Program.Events</RootNamespace>
    <Description>Program Events</Description>
    <NuspecFile>Abim.Platform.Program.Events.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version); id=$(AssemblyName); title=$(AssemblyName); author=$(Authors); owners=$(Authors); description=$(Description)</NuspecProperties>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="WebApiContrib.Core.Formatter.Protobuf">
        <Version>2.0.1</Version>
    </PackageReference> 
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="WebApiContrib.Formatting.Protobuf">
         <Version>0.9.5.0</Version>
    </PackageReference> 
  </ItemGroup> 

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" />	  
	<PackageReference Include="DocumentFormat.OpenXml" Version="2.18.0" />	  
    <PackageReference Include="IdentityModel" Version="3.0.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.5.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" /> 
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abim.Enterprise.Core.Program.Resources\Abim.Enterprise.Core.Program.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="PublicEvents\Interface\" />
  </ItemGroup>

</Project>